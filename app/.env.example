# Application
NODE_ENV=production
PORT=3000

# MongoDB
MONGO_URI=mongodb://mongo:27017/kafka_tutorials

# Redis
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=redispassword

# Kafka
KAFKA_CLIENT_ID=kafka_tutorials_app
KAFKA_BROKERS=kafka:9092

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Email (nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-user
SMTP_PASS=your-password
SMTP_FROM=kafka-tutorials@example.com